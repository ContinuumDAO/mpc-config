# Install as /etc/default/mpc-auth-docker (or merge into systemd drop-in Environment=).
#
# mpc-auth-docker-restart.service and mpc-auth-docker-update@.service use this file via:
#   EnvironmentFile=-/etc/default/mpc-auth-docker

# Exact Docker container name (Compose v2: often {project}_{service}_{index}, e.g. mpc-config_app_1 — confirm with docker ps NAMES).
MPC_AUTH_CONTAINER_NAME=mpc-config_app_1

# Optional — if unset, mpc-auth-docker-restart.sh may restart the sole *mpc-auth* image container when the above name does not exist.
# MPC_AUTH_RESTART_STRICT=1

# Registry image repo without tag; tag is systemd instance for update (@latest → pull :latest; @v1.0 → pull :v1.0).
MPC_AUTH_IMAGE=continuumdao/mpc-auth

# From POST /updateMpcAuth registryDigest; update script refuses compose if pull digest does not match when set. Optional when digest is embedded in automation JSON file.
MPC_AUTH_EXPECTED_DIGEST=

# mpc-auth POST /updateMpcAuth writes here (atomic); systemd watches this path on the host. Bind-mount rw in compose.
MPC_AUTH_DOCKER_PENDING_FILE=/var/lib/mpc-auth-docker/pending-update.json

# Directory with compose file — required for the default compose step when MPC_AUTH_POST_UPDATE_CMD is empty (recommended).
MPC_AUTH_COMPOSE_WORKDIR=
MPC_AUTH_COMPOSE_SERVICE=app

# Leave empty to use docker compose (v2 plugin) if available, else docker-compose (v1); runs: cd COMPOSE_WORKDIR && <compose> up -d COMPOSE_SERVICE.
# Uncomment to override entirely:
# MPC_AUTH_POST_UPDATE_CMD=cd /opt/stack && docker compose -f docker-compose.relay.yml up -d mpc-auth
