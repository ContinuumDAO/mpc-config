# Install as /etc/default/mpc-auth-docker (or merge into systemd drop-in Environment=).
#
# mpc-auth-docker-restart.service and mpc-auth-docker-update@.service use this file via:
#   EnvironmentFile=-/etc/default/mpc-auth-docker

# Exact Docker container name (Compose v2 plugin: often {project}-{service}-{n}, e.g. mpc-config-app-1 — confirm with docker ps NAMES).
MPC_AUTH_CONTAINER_NAME=mpc-config-app-1

# Optional — if unset, mpc-auth-docker-restart.sh may restart the sole *mpc-auth* image container when the above name does not exist.
# MPC_AUTH_RESTART_STRICT=1

# Registry image repo without tag; tag is systemd instance for update (@latest → pull :latest; @v1.0 → pull :v1.0).
MPC_AUTH_IMAGE=continuumdao/mpc-auth

# From POST /updateMpcAuth registryDigest; update script refuses compose if pull digest does not match when set. Optional when digest is embedded in automation JSON file.
MPC_AUTH_EXPECTED_DIGEST=

# mpc-auth POST /updateMpcAuth writes here (atomic); systemd watches this path on the host. Bind-mount rw in compose.
MPC_AUTH_DOCKER_PENDING_FILE=/var/lib/mpc-auth-docker/pending-update.json
# Agent LLM settings: bind-mount ./agent_llm_config from mpc-config compose (not /var/lib/mpc-auth-docker).
MPC_AUTH_AGENT_LLM_CONFIG_FILE=/app/agent_llm_config/agent-llm-config.json

# mpc-auth POST /reboot writes here (atomic); mpc-auth-docker-pending-reboot.path on the host. Same bind mount as above.
MPC_AUTH_PENDING_REBOOT_FILE=/var/lib/mpc-auth-docker/pending-reboot.json

# Directory with compose file — required when MPC_AUTH_POST_UPDATE_CMD is empty (systemd oneshots have no project cwd).
# Use an absolute path, e.g. /home/mpcnode/mpc-config
MPC_AUTH_COMPOSE_WORKDIR=
MPC_AUTH_COMPOSE_SERVICE=app

# After pull: script tags the verified ${TAG} image as this ref (default ${MPC_AUTH_IMAGE}:latest) so compose files
# that pin :latest run the build you just verified. MPC_AUTH_SKIP_RETAG_LATEST=1 disables.
# MPC_AUTH_COMPOSE_IMAGE_REF=continuumdao/mpc-auth:latest

# After a successful full update: prune unused old mpc-auth / companion images (dangling layers and superseded tags).
# MPC_AUTH_PRUNE_OLD_IMAGES=1

# Leave empty to use docker compose (v2 plugin) if available, else docker-compose (v1); runs: cd COMPOSE_WORKDIR && <compose> up -d COMPOSE_SERVICE.
# Uncomment to override entirely:
# MPC_AUTH_POST_UPDATE_CMD=cd /opt/stack && docker compose -f docker-compose.relay.yml up -d mpc-auth

# After mpc-auth image pull: optionally pull continuumdao-node-app and recreate compose service dashboard.
# Defaults match configs-original.yaml ContinuumdaoNodeApp — process_config.sh merges from configs.yaml into /etc/default.
MPC_AUTH_UPDATE_NODE_APP=1
NODE_APP_IMAGE=continuumdao/continuumdao-node-app
NODE_APP_TAG=latest
MPC_AUTH_NODE_APP_COMPOSE_SERVICE=dashboard
NODE_APP_CONTAINER_NAME=mpc-config-dashboard-1

# After mpc-auth image pull: optionally pull continuum-mcp-server and recreate compose service continuum-mcp.
# Defaults match configs-original.yaml ContinuumMcpServer — process_config.sh merges from configs.yaml into /etc/default.
MPC_AUTH_UPDATE_MCP_SERVER=1
MCP_SERVER_IMAGE=continuumdao/continuum-mcp-server
MCP_SERVER_TAG=latest
MPC_AUTH_MCP_SERVER_COMPOSE_SERVICE=continuum-mcp
MCP_SERVER_CONTAINER_NAME=mpc-config-continuum-mcp-1
