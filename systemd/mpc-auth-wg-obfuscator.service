[Unit]
Description=wg-obfuscator server for WireGuard transport obfuscation (Continuum MPC)
After=network-online.target
PartOf=mpc-auth-wireguard-wg0.service

[Service]
Type=simple
EnvironmentFile=-/etc/default/mpc-auth-docker
ExecStart=/usr/bin/env wg-obfuscator --config /var/lib/mpc-auth-docker/wg-obfuscator/server.conf
Restart=on-failure
RestartSec=5
StandardInput=null

[Install]
WantedBy=multi-user.target
