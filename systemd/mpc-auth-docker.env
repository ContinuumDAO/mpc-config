# Defaults for mpc-config Docker Compose (project directory name mpc-config, service app → container mpc-config-app-1 with Docker Compose v2).
# Install: sudo cp systemd/mpc-auth-docker.env /etc/default/mpc-auth-docker
#
# mpc-auth-docker-restart.service and mpc-auth-docker-update@.service use:
#   EnvironmentFile=-/etc/default/mpc-auth-docker
#
# If your NAMES column differs (different compose project name), set MPC_AUTH_CONTAINER_NAME to match docker ps.

MPC_AUTH_CONTAINER_NAME=mpc-config-app-1
MPC_AUTH_IMAGE=continuumdao/mpc-auth

# Auto-update (host): mpc-auth writes this file atomically after POST /updateMpcAuth; systemd watches it (see mpc-auth-docker-pending-update.path). Bind-mount /var/lib/mpc-auth-docker rw in compose.
MPC_AUTH_DOCKER_PENDING_FILE=/var/lib/mpc-auth-docker/pending-update.json

# Host reboot (host): mpc-auth writes this atomically after POST /reboot; systemd watches it (mpc-auth-docker-pending-reboot.path).
MPC_AUTH_PENDING_REBOOT_FILE=/var/lib/mpc-auth-docker/pending-reboot.json

# Set from POST /updateMpcAuth → Data.registryDigest before running the update script / systemd (pull must match or compose is skipped). Not needed when using automated pending file with digest in JSON.
MPC_AUTH_EXPECTED_DIGEST=

# Directory containing docker-compose.yml (required when MPC_AUTH_POST_UPDATE_CMD is unset). Use an absolute path.
# Example if you cloned mpc-config in your home: /home/mpcnode/mpc-config
MPC_AUTH_COMPOSE_WORKDIR=
MPC_AUTH_COMPOSE_SERVICE=app

# Optional: after pull, `docker tag` the verified image to this ref so compose (often `image: ...:latest`)
# runs the tag you requested. Default is ${MPC_AUTH_IMAGE}:latest. Set MPC_AUTH_SKIP_RETAG_LATEST=1 to disable.
# MPC_AUTH_COMPOSE_IMAGE_REF=continuumdao/mpc-auth:latest
# MPC_AUTH_SKIP_RETAG_LATEST=0

# After a successful full update: remove old tagged/dangling images for mpc-auth (and companion repos) not in use.
# Keeps the pulled tag, compose ref (usually :latest), and any image referenced by a container. Set to 0 to disable.
# MPC_AUTH_PRUNE_OLD_IMAGES=1

# Leave empty to auto-pick docker compose vs docker-compose and run up -d COMPOSE_SERVICE in COMPOSE_WORKDIR.
# Or set an explicit wrapper, e.g.: cd /srv/mpc-config && docker compose up -d app
MPC_AUTH_POST_UPDATE_CMD=

# Continuumdao node dashboard (continuumdao-node-app) — synced from configs.yaml ContinuumdaoNodeApp by process_config.sh
MPC_AUTH_UPDATE_NODE_APP=1
NODE_APP_IMAGE=continuumdao/continuumdao-node-app
NODE_APP_TAG=latest
MPC_AUTH_NODE_APP_COMPOSE_SERVICE=dashboard
NODE_APP_CONTAINER_NAME=mpc-config-dashboard-1

# Continuum MCP server (continuum-mcp-server) — synced from configs.yaml ContinuumMcpServer by process_config.sh
MPC_AUTH_UPDATE_MCP_SERVER=1
MCP_SERVER_IMAGE=continuumdao/continuum-mcp-server
MCP_SERVER_TAG=latest
MPC_AUTH_MCP_SERVER_COMPOSE_SERVICE=continuum-mcp
MCP_SERVER_CONTAINER_NAME=mpc-config-continuum-mcp-1
