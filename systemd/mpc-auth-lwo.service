[Unit]
Description=Continuum LWO server for WireGuard transport obfuscation
After=network-online.target
PartOf=mpc-auth-wireguard-wg0.service

[Service]
Type=simple
EnvironmentFile=-/etc/default/mpc-auth-docker
ExecStart=/usr/bin/env continuum-lwo-server --config /var/lib/mpc-auth-docker/lwo/server.json
Restart=on-failure
RestartSec=5
StandardInput=null

[Install]
WantedBy=multi-user.target
