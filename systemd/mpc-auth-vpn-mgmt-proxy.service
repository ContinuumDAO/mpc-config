[Unit]
Description=Proxy management API on wg0 for VPN clients (10.8.0.1:8080 -> 127.0.0.1:8080)
After=mpc-auth-wireguard-wg0.service
Requires=mpc-auth-wireguard-wg0.service

[Service]
Type=simple
EnvironmentFile=-/etc/default/mpc-auth-docker
# Rewrites Host and sets X-Continuum-Vpn-Peer. A raw TCP forward lets a peer send Host: localhost.
ExecStart=/usr/bin/env python3 /usr/local/libexec/mpc-auth/mpc-auth-vpn-mgmt-proxy.py
Restart=on-failure
RestartSec=3
StandardInput=null

[Install]
WantedBy=multi-user.target
