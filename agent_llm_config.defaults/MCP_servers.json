{
  "servers": [
    {
      "id": "duckduckgo",
      "displayName": "DuckDuckGo search",
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "duckduckgo-mcp-server"],
      "initialLoad": false
    },
    {
      "id": "brave-search",
      "displayName": "Brave Search",
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-brave-search"],
      "apiKeyEnvVar": "BRAVE_API_KEY",
      "envVars": ["BRAVE_API_KEY"],
      "runtime": {
        "requireCommands": ["npx"]
      },
      "initialLoad": false
    },
    {
      "id": "google-search",
      "displayName": "Google Search (Custom Search API)",
      "setupUrl": "https://github.com/adenot/mcp-google-search",
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "@adenot/mcp-google-search"],
      "apiKeyEnvVar": "GOOGLE_API_KEY",
      "envVars": ["GOOGLE_API_KEY", "GOOGLE_SEARCH_ENGINE_ID"],
      "runtime": {
        "requireCommands": ["npx"]
      },
      "initialLoad": false
    },
    {
      "id": "finance-news",
      "displayName": "Finance News RSS",
      "transport": "stdio",
      "command": "uv",
      "args": [
        "run",
        "--with",
        "git+https://github.com/jvenkatasandeep/finance-news-mcp",
        "python",
        "-m",
        "main"
      ],
      "runtime": {
        "requireCommands": ["uv"]
      },
      "initialLoad": false
    },
    {
      "id": "foundry",
      "displayName": "Foundry (Forge, Cast, Anvil)",
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "@pranesh.asp/foundry-mcp-server"],
      "useUserFolder": true,
      "runtime": {
        "requireCommands": ["npx", "forge", "cast", "anvil", "heimdall"]
      },
      "initialLoad": false
    },
    {
      "id": "etherscan",
      "displayName": "Etherscan (API v2)",
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "mcp-etherscan-server"],
      "apiKeyEnvVar": "ETHERSCAN_API_KEY",
      "envVars": ["ETHERSCAN_API_KEY"],
      "runtime": {
        "requireCommands": ["npx"]
      },
      "initialLoad": false
    },
    {
      "id": "dune",
      "displayName": "Dune Analytics",
      "transport": "http",
      "url": "https://api.dune.com/mcp/v1",
      "apiKeyEnvVar": "DUNE_API_KEY",
      "apiKeyHeader": "x-dune-api-key",
      "initialLoad": false
    },
    {
      "id": "coingecko",
      "displayName": "CoinGecko (public)",
      "transport": "http",
      "url": "https://mcp.api.coingecko.com/mcp",
      "initialLoad": false
    },
    {
      "id": "coingecko-pro",
      "displayName": "CoinGecko Pro",
      "transport": "http",
      "url": "https://mcp.pro-api.coingecko.com/mcp",
      "apiKeyEnvVar": "COINGECKO_API_KEY",
      "apiKeyHeader": "x-cg-pro-api-key",
      "initialLoad": false
    },
    {
      "id": "altfins",
      "displayName": "altFINS (crypto analytics)",
      "transport": "http",
      "url": "https://mcp.altfins.com/mcp",
      "apiKeyEnvVar": "ALTFINS_API_KEY",
      "apiKeyHeader": "X-Api-Key",
      "initialLoad": false
    },
    {
      "id": "messari",
      "displayName": "Messari (crypto intelligence)",
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "@messari/sdk-ts-mcp@latest", "--client=claude", "--tools=dynamic"],
      "apiKeyEnvVar": "MESSARI_SDK_API_KEY",
      "envVars": ["MESSARI_SDK_API_KEY"],
      "runtime": {
        "requireCommands": ["npx"]
      },
      "initialLoad": false
    },
    {
      "id": "alphavantage",
      "displayName": "Alpha Vantage (stock market data)",
      "transport": "stdio",
      "command": "uvx",
      "args": ["--from", "marketdata-mcp-server", "marketdata-mcp"],
      "apiKeyEnvVar": "ALPHA_VANTAGE_API_KEY",
      "envVars": ["ALPHA_VANTAGE_API_KEY"],
      "runtime": {
        "requireCommands": ["uv"]
      },
      "initialLoad": false
    },
    {
      "id": "technical-indicators",
      "displayName": "Technical indicators",
      "setupUrl": "https://github.com/ContinuumDAO/continuum-node-sdk",
      "transport": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "-p",
        "@continuumdao/continuum-node-sdk",
        "continuum-ta-mcp"
      ],
      "runtime": {
        "requireCommands": ["npx"]
      },
      "initialLoad": false,
      "aiReady": false
    },
    {
      "id": "binance",
      "displayName": "Binance (public market data)",
      "transport": "stdio",
      "command": "uv",
      "args": [
        "run",
        "--with",
        "fastmcp>=0.1.0",
        "--with",
        "httpx>=0.27.0",
        "--with",
        "pydantic>=2.0.0",
        "https://raw.githubusercontent.com/danishashko/binance-mcp-server/main/binance_mcp.py"
      ],
      "runtime": {
        "requireCommands": ["uv"]
      },
      "initialLoad": false
    },
    {
      "id": "whale-tracker",
      "displayName": "Whale Tracker (Whale Alert)",
      "transport": "stdio",
      "command": "uv",
      "args": [
        "run",
        "--with",
        "httpx>=0.28.1",
        "--with",
        "mcp[cli]>=1.4.0",
        "--with",
        "python-dotenv",
        "https://raw.githubusercontent.com/kukapay/whale-tracker-mcp/main/whale-tracker.py"
      ],
      "apiKeyEnvVar": "WHALE_ALERT_API_KEY",
      "envVars": ["WHALE_ALERT_API_KEY"],
      "runtime": {
        "requireCommands": ["uv"]
      },
      "initialLoad": false
    },
    {
      "id": "x",
      "displayName": "X (Twitter)",
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "@iflow-mcp/datawhisker-x-mcp-server"],
      "envVars": [
        "TWITTER_API_KEY",
        "TWITTER_API_SECRET",
        "TWITTER_ACCESS_TOKEN",
        "TWITTER_ACCESS_SECRET"
      ],
      "initialLoad": false
    }
  ]
}
