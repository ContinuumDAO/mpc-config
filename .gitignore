# Certificate files (private keys should never be committed)
mosquitto/config/certs/

# Certificate directory (optional - uncomment if you want to ignore all certs)
# mosquitto/config/certs/

# Internal docs
docs/internal/

# Secrets (Compose; see .env.example)
.env

# config
configs.yaml

# Generated at repo root by process_config.sh from docker-compose.relay.yml or docker-compose.client.yml
# Leading "/" = only mpc-config/docker-compose.yml.
/docker-compose.yml

# webTLS
webTLS/config/certs/

# Encrypted DB backup envelopes (POST /backupDatabase); may contain sensitive ciphertext
database_backups/

# Agent LLM config (may contain API key material in agent-llm-config.json)
agent_llm_config/

# Ed25519 management private keys (POST /addManagementKey; bind-mounted into app + continuum-mcp)
.mpa/management_keys/
# Symlink to bootstrap_key/ (ensure_mpa_bootstrap_key_symlink in process_config.sh)
.mpa/bootstrap_key

# POST /restoreDatabase pre-restore mongodump snapshots (operators may copy off-host)
.mongodump/

# Data directories
data/
mosquitto/data/
mosquitto/log/
keys/

# Logs
*.log
logs/

# OS files
.DS_Store
Thumbs.db

# Editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Temporary files
*.tmp
*.bak

# Foundry (forge/ subproject)
forge/out/
forge/cache/
forge/broadcast/

#Python compilations
scripts/__pycache__/
recipes/__pycache__/
tools/__pycache__/
