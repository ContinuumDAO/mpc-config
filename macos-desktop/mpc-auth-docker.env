# macOS Desktop (Docker extension / direct install) — repo-local env for mpc-auth host automation.
# Installed by install-macos-desktop-host-automation.sh (MPC_AUTH_COMPOSE_WORKDIR set at install time).

MPC_AUTH_CONTAINER_NAME=mpc-config-app-1
MPC_AUTH_IMAGE=continuumdao/mpc-auth

MPC_AUTH_DOCKER_PENDING_FILE=/var/lib/mpc-auth-docker/pending-update.json
MPC_AUTH_PENDING_REBOOT_FILE=/var/lib/mpc-auth-docker/pending-reboot.json

MPC_AUTH_VPN_PENDING_FILE=/var/lib/mpc-auth-docker/pending-vpn.json
MPC_AUTH_VPN_STATE_FILE=/var/lib/mpc-auth-docker/vpn-state.json
MPC_AUTH_WIREGUARD_SRC_DIR=/var/lib/mpc-auth-docker/wireguard
MPC_AUTH_WIREGUARD_LISTEN_PORT=51820
MPC_AUTH_VPN_MGMT_PORT=8080

MPC_AUTH_SHADOWSOCKS_SRC_DIR=/var/lib/mpc-auth-docker/shadowsocks
MPC_AUTH_SHADOWSOCKS_LISTEN_PORT=8388

MPC_AUTH_EXPECTED_DIGEST=
MPC_AUTH_COMPOSE_WORKDIR=
MPC_AUTH_COMPOSE_SERVICE=app
MPC_AUTH_POST_UPDATE_CMD=

MPC_AUTH_UPDATE_NODE_APP=1
NODE_APP_IMAGE=continuumdao/continuumdao-node-app
NODE_APP_TAG=latest
MPC_AUTH_NODE_APP_COMPOSE_SERVICE=dashboard
NODE_APP_CONTAINER_NAME=mpc-config-dashboard-1

MPC_AUTH_UPDATE_MCP_SERVER=1
MCP_SERVER_IMAGE=continuumdao/continuum-mcp-server
MCP_SERVER_TAG=latest
MPC_AUTH_MCP_SERVER_COMPOSE_SERVICE=continuum-mcp
MCP_SERVER_CONTAINER_NAME=mpc-config-continuum-mcp-1
