# Maintainer: ContinuumDAO <https://github.com/ContinuumDAO/mpc-config>
# Omarchy and Arch can install the release package with pacman -U.
# This recipe builds the same binary from the mpc-auth sources.
pkgname=mpc-chat
pkgver=0.1.0
pkgrel=1
pkgdesc="Terminal chat for the AI agent on a Continuum node"
arch=('x86_64' 'aarch64')
url="https://github.com/ContinuumDAO/mpc-config"
license=('BUSL-1.1')
depends=('openssh')
makedepends=('go' 'git')
source=("git+https://github.com/Selqui/mpc-auth.git")
sha256sums=('SKIP')

build() {
  cd mpc-auth
  CGO_ENABLED=0 go build -trimpath -o "$srcdir/mpc-chat" ./cli/mpc-chat
}

package() {
  install -Dm755 "$srcdir/mpc-chat" "$pkgdir/usr/bin/mpc-chat"
}
