# Docker Compose (mpc-config root). Copy to ".env" — see README "MongoDB authentication".
# After copying: chmod u=rw,go= .env   (owner read/write only; process_config.sh does this when it creates .env)
# Alternatively: export MONGO_INITDB_ROOT_PASSWORD and MONGO_APP_PASSWORD (and optional MONGO_* / MongodbUri)
# and run ./process_config.sh — it will copy this file to .env when .env is absent (see PROCESS_CONFIG_MERGE_* env in --help).
#
# Optional MongoDB authentication (recommended in production): set passwords below and set
# MongodbUri so the app can authenticate (see commented example).
# Leave passwords empty for legacy installs (existing ./data/mongodb volumes without auth).

# ── Mongo admin account (MongoDB built-in root *role* on db admin; username is arbitrary — not the OS root user).
MONGO_INITDB_ROOT_USERNAME=mongoRoot
MONGO_INITDB_ROOT_PASSWORD=
MONGO_APP_USER=mpcauth
MONGO_APP_PASSWORD=
MONGO_APP_DATABASE=DistributedAuth
# Match DBName / path in MongodbUri (default DistributedAuth). If configs.yaml DBName differs, align this + URI.

# Optional: mpc-auth MongodbUri (env override; overrides configs.yaml empty default).
# When using auth — example (percent-encode @ : # / ? in passwords if needed):
# MongodbUri=mongodb://mpcauth:YOURPASSWORD@mongodb:27017/DistributedAuth?authSource=DistributedAuth
