# --- Docker image (defaults match continuumdao-node-app push script) ---
NODE_APP_IMAGE=continuumdao/continuumdao-node-app
NODE_APP_TAG=latest

# --- Published port on your machine (container listens on 3000 internally) ---
NODE_APP_PORT=3333

# Show “Plain HTTP” in attach UI (omit on Railway production; required for local/docker installs).
ENABLE_PLAIN_HTTP_ATTACH=1

# --- Reown / WalletConnect (required) ---
# Create a project at https://cloud.reown.com
REOWN_PROJECT_ID=

# --- Allow the Next.js server to proxy discovery to private & loopback hosts (local mpc-auth) ---
NODE_READ_DISCOVERY_ALLOW_PRIVATE=1

# Optional: mpc-auth ports if your configs differ from defaults
# DEFAULT_NODE_DISCOVERY_PORT=18080
# BROWSER_HTTPS_PORT=8443
# MANAGEMENT_API_PORT=8080
