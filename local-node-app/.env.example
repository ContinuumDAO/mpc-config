# --- Docker image (defaults match continuumdao-node-app push script) ---
NODE_APP_IMAGE=continuumdao/continuumdao-node-app
NODE_APP_TAG=latest

# --- Published port on your machine (container listens on 3000 internally) ---
NODE_APP_PORT=3333

# Show “Plain HTTP” in attach UI (omit on Railway production; required for local/docker installs).
ENABLE_PLAIN_HTTP_ATTACH=1

# --- Reown / WalletConnect (required) ---
# Create a project at https://cloud.reown.com
REOWN_PROJECT_ID=

# --- Allow the Next.js server to proxy discovery to private & loopback hosts (local mpc-auth) ---
NODE_READ_DISCOVERY_ALLOW_PRIVATE=1

# Optional: NAT hairpin — when mpc-config nodeAddresses use your public IPv4 but this dashboard runs on the
# same host as mpc-auth, the Next.js server often cannot dial http://<WAN-ip>:<port> (no route / unreachable).
# Map that public IPv4 to where mpc-auth listens inside the container/network namespace you use (often 127.0.0.1
# if the app reaches the node via host loopback). Comma-separated WAN=bind pairs.
# NODE_READ_DISCOVERY_LOCAL_BIND_ALIASES=203.0.113.5=127.0.0.1

# Requires NODE_READ_DISCOVERY_ALLOW_PRIVATE=1: on public-IPv4 dial failure (unreachable / no route), retry via 127.0.0.1.
# Prefer LOCAL_BIND_ALIASES when you know the WAN IP; use this for quick local dev only.
# NODE_READ_DISCOVERY_HAIRPIN_FALLBACK=1

# Optional: mpc-auth ports if your configs differ from defaults
# DEFAULT_NODE_DISCOVERY_PORT=18080
# BROWSER_HTTPS_PORT=8443
# MANAGEMENT_API_PORT=8080
